# Required for US place search, real driving estimates and the browser map.
# Put real values in ignored .env.local and restart the local server.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Optional map ID. DEMO_MAP_ID is sufficient for local prototype testing.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
PORT=5174

# Legacy OSM adapters remain available only to isolated engineering tests.
# The consumer app does not use them as a Google failure fallback.
