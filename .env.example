# Required for US place search, real driving estimates and the browser map.
# Put real values in ignored .env.local and restart the local server.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Optional map ID. DEMO_MAP_ID is sufficient for local prototype testing.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
PORT=5174

# Runtime reasoning is OFF until the founder approves paid calls and a spending limit.
# Keep secrets in .env.local / hosted server secrets. No VITE_ prefix for server keys.
ROVELLE_MODEL_ENABLED=false
OPENAI_API_KEY=
# Set an account-supported Responses + Structured Outputs model only after approval.
ROVELLE_MODEL=
# Optional verified rates for approximate model cost telemetry; blank = unknown.
ROVELLE_MODEL_INPUT_USD_PER_MILLION=
ROVELLE_MODEL_OUTPUT_USD_PER_MILLION=

# Legacy OSM adapters remain available only to isolated engineering tests.
# The consumer app does not use them as a Google failure fallback.
