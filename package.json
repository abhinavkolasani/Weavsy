{
  "name": "outing-planner-v01",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types server/start.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-cloud.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:pre-ai:live": "node --experimental-strip-types scripts/verify-pre-ai.mjs",
    "db:generate": "drizzle-kit generate",
    "catalog:inspect": "node --experimental-strip-types scripts/inspect-catalog.ts",
    "start": "node --experimental-strip-types server/start.mjs --production",
    "catalog:import": "node --experimental-strip-types scripts/import-catalog.ts"
  },
  "dependencies": {
    "maplibre-gl": "6.11.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.4",
    "@types/node": "^24.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
